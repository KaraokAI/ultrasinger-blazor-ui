# Parent of the UltraStar "songs" directory (mounted at /library in the container).
ULTRASTAR_DIR="/run/media/sacredskull/Storage 2/UltraStar"

# Shared secret the UI sends as X-Api-Key. Empty = unauthenticated.
PROCESSOR_API_KEY=

OPENAI_API_KEY=
ENABLE_OPENAI_CORRECTIONS=false

# Defaults to ~/.config/mozilla/firefox
# FIREFOX_PROFILE_DIR=
