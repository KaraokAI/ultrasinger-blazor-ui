@using UltraSinger.Blazor.Services
@using UltraSinger.Contracts
@inject IUltraStarPlayService UltraStarPlayService

<div class="flex flex-col h-full space-y-4">
    <!-- Header with Status -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div>
            <h2 class="text-xl font-bold text-slate-100 flex items-center gap-2">
                <span>🎮 UltraStar Play / Companion Queue</span>
                @if (IsLoadingStatus)
                {
                    <span class="inline-block w-3 h-3 rounded-full bg-yellow-400 animate-pulse"></span>
                }
                else if (Status.IsConnected)
                {
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-emerald-900/80 text-emerald-200 border border-emerald-700 flex items-center gap-1.5">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span> Connected
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-rose-900/80 text-rose-200 border border-rose-700 flex items-center gap-1.5">
                        <span class="inline-block w-2 h-2 rounded-full bg-rose-400"></span> Disconnected
                    </span>
                }
            </h2>
            <p class="text-xs text-slate-400">
                Host: <code class="text-indigo-300">@Status.ServerAddress:@Status.HttpPort</code> | UDP: <code class="text-indigo-300">34567</code>
                @if (Status.IsConnected)
                {
                    <span> | Loaded in Game: <strong class="text-slate-200">@Status.LoadedSongsCount</strong> songs</span>
                    @if (Status.AvailablePlayers.Count > 0)
                    {
                        <span> | Players: <strong class="text-slate-200">@string.Join(", ", Status.AvailablePlayers)</strong></span>
                    }
                }
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button @onclick="RefreshAsync" class="px-3 py-1.5 text-xs font-semibold rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 transition flex items-center gap-1.5">
                <span class="@(IsRefreshing ? "animate-spin" : "")">🔄</span>
                <span>Refresh Queue</span>
            </button>
            @if (QueueEntries.Count > 0)
            {
                <button @onclick="ClearAllQueueAsync" class="px-3 py-1.5 text-xs font-semibold rounded bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700 transition">
                    Clear Queue
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(FeedbackMessage))
    {
        <div class="p-3 rounded-lg text-sm @(IsFeedbackError ? "bg-red-950/80 text-red-200 border border-red-800" : "bg-emerald-950/80 text-emerald-200 border border-emerald-800")">
            @FeedbackMessage
        </div>
    }

    @if (!Status.IsConnected && !string.IsNullOrEmpty(Status.ErrorMessage))
    {
        <div class="p-3 rounded-lg text-xs bg-slate-900 text-slate-300 border border-slate-700">
            <strong class="text-amber-400">Connection Note:</strong> @Status.ErrorMessage
            <p class="mt-1 text-slate-400">
                Make sure UltraStar Play or Melody Mania is running on this machine and the HTTP Companion Server is enabled in the game settings (port 6789).
            </p>
        </div>
    }

    <!-- Active Song Queue -->
    <div class="flex-grow flex flex-col min-h-0 bg-slate-900/60 rounded-lg border border-slate-800 p-3">
        <h3 class="text-sm font-semibold text-slate-300 mb-2 flex items-center justify-between">
            <span>Current In-Game Queue (@(QueueEntries.Count))</span>
            @if (QueueEntries.Count > 0)
            {
                <span class="text-xs text-slate-500 font-normal">Songs will play in this order</span>
            }
        </h3>

        <div class="flex-grow overflow-y-auto space-y-2 pr-1">
            @if (QueueEntries.Count == 0)
            {
                <div class="p-8 text-center text-slate-400">
                    <p class="text-sm font-medium">No songs currently queued in UltraStar Play.</p>
                    <p class="text-xs text-slate-500 mt-1">
                        Download a song or click "Queue in Game" from the Song Library to add songs to the queue.
                    </p>
                </div>
            }
            else
            {
                @for (int i = 0; i < QueueEntries.Count; i++)
                {
                    var index = i;
                    var entry = QueueEntries[i];
                    <div class="flex items-center justify-between p-3 rounded-lg border border-slate-700 bg-slate-800/80 hover:bg-slate-800 transition">
                        <div class="flex items-center space-x-3 overflow-hidden">
                            <span class="w-6 h-6 rounded-full bg-slate-700 flex items-center justify-center text-xs font-bold text-slate-300 flex-shrink-0">
                                @(index + 1)
                            </span>
                            <div class="overflow-hidden">
                                <div class="text-sm font-semibold text-slate-100 truncate">
                                    @(string.IsNullOrWhiteSpace(entry.SongDto.Artist) ? entry.SongDto.Title : $"{entry.SongDto.Artist} - {entry.SongDto.Title}")
                                </div>
                                <div class="text-xs text-slate-400 flex items-center gap-2 mt-0.5">
                                    @if (entry.SingScenePlayerDataDto.PlayerProfileNames.Count > 0)
                                    {
                                        <span>🎤 @string.Join(", ", entry.SingScenePlayerDataDto.PlayerProfileNames)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(entry.SongDto.Hash))
                                    {
                                        <span class="text-slate-500 truncate" title="@entry.SongDto.Hash">#@entry.SongDto.Hash.Substring(0, Math.Min(8, entry.SongDto.Hash.Length))</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <button @onclick="() => DeleteEntryAsync(index)" class="px-2 py-1 text-xs text-rose-300 hover:text-rose-100 hover:bg-rose-950/60 rounded transition">
                            ✕ Remove
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private UltraStarPlayStatus Status { get; set; } = new();
    private List<UltraStarPlayQueueEntryDto> QueueEntries { get; set; } = new();
    private bool IsLoadingStatus { get; set; } = true;
    private bool IsRefreshing { get; set; } = false;
    private string? FeedbackMessage { get; set; }
    private bool IsFeedbackError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        IsRefreshing = true;
        IsLoadingStatus = true;
        StateHasChanged();

        try
        {
            Status = await UltraStarPlayService.CheckConnectionAsync();
            if (Status.IsConnected)
            {
                var queue = await UltraStarPlayService.GetSongQueueAsync();
                QueueEntries = queue.ToList();
            }
            else
            {
                QueueEntries.Clear();
            }
        }
        catch (Exception ex)
        {
            FeedbackMessage = $"Failed to communicate with UltraStar Play: {ex.Message}";
            IsFeedbackError = true;
        }
        finally
        {
            IsLoadingStatus = false;
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteEntryAsync(int index)
    {
        FeedbackMessage = null;
        try
        {
            var success = await UltraStarPlayService.DeleteQueueEntryAsync(index);
            if (success)
            {
                FeedbackMessage = "Removed song from game queue.";
                IsFeedbackError = false;
                await RefreshAsync();
            }
            else
            {
                FeedbackMessage = "Failed to remove song from game queue.";
                IsFeedbackError = true;
            }
        }
        catch (Exception ex)
        {
            FeedbackMessage = $"Error: {ex.Message}";
            IsFeedbackError = true;
        }
    }

    private async Task ClearAllQueueAsync()
    {
        FeedbackMessage = null;
        try
        {
            var success = await UltraStarPlayService.DeleteAllQueueEntriesAsync();
            if (success)
            {
                FeedbackMessage = "Cleared UltraStar Play song queue.";
                IsFeedbackError = false;
                await RefreshAsync();
            }
            else
            {
                FeedbackMessage = "Failed to clear game queue.";
                IsFeedbackError = true;
            }
        }
        catch (Exception ex)
        {
            FeedbackMessage = $"Error: {ex.Message}";
            IsFeedbackError = true;
        }
    }
}
