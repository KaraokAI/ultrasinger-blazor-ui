@using System.Web
@using UltraSinger.Contracts
@{
    var showingResults = !string.IsNullOrEmpty(SearchQuery) && Results is { Count: 0 };
}

<div class="flex-grow flex flex-col h-full">
    @if (!string.IsNullOrEmpty(FeedbackMessage))
    {
        <div class="mb-2 p-2 bg-slate-800 text-slate-100 rounded text-sm border border-slate-600">
            @FeedbackMessage
        </div>
    }

    <div class="flex-grow overflow-y-scroll space-y-2 pr-2">
        @if (IsLoading)
        {
            <div class="flex items-center space-x-2 text-slate-300 p-3">
                <span class="animate-spin inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full"></span>
                <span>Searching Local Library, USDB, and YouTube...</span>
            </div>
        }
        else if (Results is { Count: > 0 })
        {
            <div class="space-y-2">
                @foreach (var result in Results)
                {
                    <div class="flex items-center justify-between p-3 rounded-lg border border-slate-700 bg-slate-900/80 hover:bg-slate-800/90 transition">
                        <div class="flex items-center space-x-3 overflow-hidden flex-grow mr-2">
                            @if (!string.IsNullOrWhiteSpace(result.ThumbnailUrl))
                            {
                                <img class="w-16 h-12 object-cover rounded shadow" src="@result.ThumbnailUrl" alt="thumbnail" />
                            }
                            <div class="overflow-hidden">
                                <div class="flex items-center space-x-2">
                                    @if (result.Source == SongSource.Local)
                                    {
                                        <span class="px-2 py-0.5 text-xs font-bold rounded bg-emerald-700 text-emerald-100">LOCAL</span>
                                    }
                                    else if (result.Source == SongSource.USDB)
                                    {
                                        <span class="px-2 py-0.5 text-xs font-bold rounded bg-blue-700 text-blue-100">USDB</span>
                                        @if (result.HasGoldenNotes == true)
                                        {
                                            <span class="px-1.5 py-0.5 text-xs font-bold rounded bg-amber-600 text-amber-100" title="Golden Notes">★ Gold</span>
                                        }
                                        @if (result.Rating.HasValue && result.Rating > 0)
                                        {
                                            <span class="text-xs text-yellow-400">★ @result.Rating.Value.ToString("0.#")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 text-xs font-bold rounded bg-red-700 text-red-100">YouTube</span>
                                    }

                                    <strong class="text-slate-100 truncate">
                                        @HttpUtility.HtmlDecode(result.DisplayTitle)
                                    </strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(result.ExtraInfo))
                                {
                                    <div class="text-xs text-slate-400 mt-0.5 truncate">
                                        @result.ExtraInfo
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(result.Description))
                                {
                                    <div class="text-xs text-slate-400 mt-0.5 truncate">
                                        @result.Description
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="flex-shrink-0 flex items-center gap-2">
                            @if (result.Source == SongSource.Local)
                            {
                                <span class="px-2.5 py-1 text-xs font-semibold text-emerald-300 bg-emerald-950/60 rounded-full border border-emerald-800">
                                    In Library
                                </span>
                                <button @onclick="() => OnQueueInGame(result)"
                                        disabled="@(QueuingSongTitle == result.DisplayTitle)"
                                        class="px-3 py-1.5 text-xs font-semibold rounded bg-emerald-700 hover:bg-emerald-600 disabled:opacity-50 text-white transition flex items-center gap-1 shadow-sm">
                                    @if (QueuingSongTitle == result.DisplayTitle)
                                    {
                                        <span class="animate-spin">⏳</span>
                                        <span>Queuing...</span>
                                    }
                                    else
                                    {
                                        <span>🎮</span>
                                        <span>Queue</span>
                                    }
                                </button>
                            }
                            else if (result.Source == SongSource.USDB)
                            {
                                @if (ProcessingSongId == result.UsdbSongId)
                                {
                                    <button disabled class="px-3 py-1.5 text-xs font-semibold rounded bg-blue-900 text-blue-300 opacity-60">
                                        Queuing...
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="() => OnSelectResult(result)" class="px-3 py-1.5 text-xs font-semibold rounded bg-blue-600 hover:bg-blue-500 text-white transition">
                                        Request
                                    </button>
                                }
                            }
                            else
                            {
                                <button @onclick="() => OnSelectResult(result)" class="px-3 py-1.5 text-xs font-semibold rounded bg-red-600 hover:bg-red-500 text-white transition">
                                    Request
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (showingResults && !HasQueued)
        {
            <p class="text-slate-400 p-3">No results found across Local Library, USDB, or YouTube.</p>
        }
    </div>

    @if (!IsRateLimited)
    {
        <form class="my-3 flex w-full gap-3 text-slate-900" @onsubmit="@PerformSearch">
            <input @bind="SearchQuery" class="form-control flex-grow w-full border p-3 rounded shadow-md bg-slate-100" placeholder="Search local library, USDB, or YouTube..."/>
            <button type="submit" class="px-6 py-3 font-semibold rounded bg-indigo-600 hover:bg-indigo-500 text-white transition shadow @(string.IsNullOrWhiteSpace(SearchQuery) ? "opacity-50 cursor-not-allowed" : "")">
                Search
            </button>
        </form>   
    }
    else
    {
        <p class="text-lg p-3 text-amber-300">
            ⏳ The YouTube gods are angry at our transgressions... please wait @(RateLimitTimer.Interval/1000)s 🙏 
        </p>
    }
</div>
