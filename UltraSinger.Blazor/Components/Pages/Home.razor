@page "/"
@using UltraSinger.Blazor.Components.Pages.Components

<ProcessorStatus/>

<div class="flex flex-col h-full w-full dark text-slate-100 mic-backdrop">
    <!-- Top Navigation / Subview Tabs Bar -->
    <header class="flex flex-col sm:flex-row items-center justify-between gap-3 p-3 bg-slate-900/90 border-b border-slate-800 backdrop-blur-md rounded-t-xl mb-3">
        <div class="flex items-center gap-3">
            <h1 class="text-lg font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 flex items-center gap-2">
                <span>🎤 UltraSinger UI</span>
            </h1>

            <nav class="flex items-center gap-1 bg-slate-950/80 p-1 rounded-lg border border-slate-800">
                <button @onclick="() => SetActiveTab(TabType.Search)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition flex items-center gap-1.5 @(ActiveTab == TabType.Search ? "bg-indigo-600 text-white shadow" : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60")">
                    <span>🔍</span>
                    <span>Search & Add</span>
                </button>
                <button @onclick="() => SetActiveTab(TabType.Library)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition flex items-center gap-1.5 @(ActiveTab == TabType.Library ? "bg-indigo-600 text-white shadow" : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60")">
                    <span>📚</span>
                    <span>Song Library</span>
                </button>
                <button @onclick="() => SetActiveTab(TabType.Queue)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition flex items-center gap-1.5 @(ActiveTab == TabType.Queue ? "bg-indigo-600 text-white shadow" : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60")">
                    <span>🎵</span>
                    <span>Song Queue</span>
                    @if (SongQueueService.Count > 0)
                    {
                        <span class="px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-pink-500 text-white">
                            @SongQueueService.Count
                        </span>
                    }
                </button>
                <button @onclick="() => SetActiveTab(TabType.Downloads)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition flex items-center gap-1.5 @(ActiveTab == TabType.Downloads ? "bg-indigo-600 text-white shadow" : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60")">
                    <span>📥</span>
                    <span>Downloads & Logs</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Direct Link Add Modal / Bar -->
    @if (ShowAddModal)
    {
        <div class="mb-3 p-3 bg-slate-900/95 rounded-lg border border-indigo-500/50 shadow-lg flex flex-col gap-2">
            <div class="flex justify-between items-center text-xs text-slate-300">
                <span class="font-semibold">Add Song by Direct Link or USDB ID:</span>
                <button @onclick="ToggleAddModal" class="text-slate-400 hover:text-slate-200">✕ Close</button>
            </div>
            <AddSong />
        </div>
    }

    <!-- Main Content Area based on Selected Tab -->
    <main class="flex-grow min-h-0 overflow-hidden flex flex-col p-2">
        @switch (ActiveTab)
        {
            case TabType.Search:
                <div class="flex flex-col lg:flex-row h-full gap-4">
                    <div class="w-full lg:w-3/5 h-full flex flex-col min-h-0">
                        <YouTubeSearch />
                    </div>
                    <div class="w-full lg:w-2/5 h-full flex flex-col min-h-0 border-t lg:border-t-0 lg:border-l border-slate-800 pt-4 lg:pt-0 lg:pl-4">
                        <div class="h-1/2 min-h-0 mb-3">
                            <History />
                        </div>
                        <div class="h-1/2 min-h-0 relative overflow-hidden bg-slate-950/60 rounded-lg border border-slate-800 p-2">
                            <div class="text-xs font-semibold text-slate-400 mb-1">Live Processing Output</div>
                            <div class="h-[calc(100%-1.5rem)] overflow-y-auto">
                                <OutputReading />
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case TabType.Library:
                <div class="h-full min-h-0">
                    <SongLibraryView />
                </div>
                break;

            case TabType.Queue:
                <div class="h-full min-h-0">
                    <SongQueueView />
                </div>
                break;

            case TabType.Downloads:
                <div class="flex flex-col lg:flex-row h-full gap-4">
                    <div class="w-full lg:w-1/2 h-full flex flex-col min-h-0 bg-slate-900/60 rounded-lg border border-slate-800 p-3">
                        <History />
                    </div>
                    <div class="w-full lg:w-1/2 h-full flex flex-col min-h-0 bg-slate-950/60 rounded-lg border border-slate-800 p-3">
                        <h3 class="text-base font-bold text-slate-200 mb-2">Live Processing Logs</h3>
                        <div class="flex-grow overflow-y-auto font-mono text-xs">
                            <OutputReading />
                        </div>
                    </div>
                </div>
                break;
        }
    </main>
</div>