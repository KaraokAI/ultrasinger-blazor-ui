@page "/"
@using UltraSingerUI.Components.Pages.Components

<CascadingValue Value="SongProcessorService">
    <div class="flex dark w-full mic-backdrop">
        <div class="flex flex-col w-3/5 h-full">
            <div class="w-full h-2/5 text-lg">
                <History/>
            </div>
            <div class="w-full mt-7 h-3/5">
                <YouTubeSearch/>
            </div>
        </div>
        <div class="w-2/5 h-full relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-transparent via-transparent to-white pointer-events-none">
            </div>
            <div class="m-3 wrap-break-word h-full overflow-y-scroll">
                <OutputReading/>
            </div>
        </div>
    </div>
</CascadingValue>
