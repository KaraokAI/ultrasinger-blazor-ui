@page "/"
@using UltraSingerUI.Components.Pages.Components

<CascadingValue Value="SongProcessorService">
    <div class="flex flex-col dark w-full h-full">
        <div class="flex flex-col h-full w-full">
            <div class="flex flex-row h-full">
                <div class="md:w-1/2 w-full text-lg h-full">
                    <History/>
                </div>
                <div class="md:w-1/2 w-full hidden md:block shadow-md rounded-md min-w-96 px-6 bg-gray-900 text-white overflow-auto h-full">
                    <OutputReading/>
                </div>
            </div>
        </div>
        <div class="flex-grow"></div>
        <div class="flex flex-col py-5 w-full">
            <AddSong />
        </div>
    </div>
</CascadingValue>
